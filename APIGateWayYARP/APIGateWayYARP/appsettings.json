{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Yarp.ReverseProxy": "Debug"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Key": "THIS_IS_MY_SUPER_SECRET_KEY_123456",
    "Issuer": "FurnitureAuth",
    "Audience": "FurnitureUsers"
  },




  "ReverseProxy": {

    "Routes": {

      "customer-swagger-route": {

        "ClusterId": "CustomerCluster",

        "Match": {
          "Path": "/customer/swagger/{**catch-all}"
        },

        "Transforms": [
          {
            "PathRemovePrefix": "/customer"
          }
        ]
      },

      "login": {
        "ClusterId": "CustomerCluster",
        "Match": {
          "Path": "/api/Login/{**catch-all}"
        }
      },



      "customer": {

        "ClusterId": "CustomerCluster",

        "Match": {

          "Path": "/customer/{**catch-all}"

        },
        "Transforms": [
          {
            "PathRemovePrefix": "/customer"
          }
        ]

      },


      "product-swagger-route": {
        "ClusterId": "ProductCluster",
        "Match": {
          "Path": "/product/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/product"
          }
        ]
      },

      "product": {

        "ClusterId": "ProductCluster",

        "Match": {

          "Path": "/product/{**catch-all}"

        },
        "Transforms": [
          {
            "PathRemovePrefix": "/product"
          }
        ]

      },


      "order-swagger-route": {
        "ClusterId": "OrderCluster",
        "Match": {
          "Path": "/order/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/order"
          }
        ]
      },

      "order": {

        "ClusterId": "OrderCluster",

        "Match": {

          "Path": "/order/{**catch-all}"

        },
        "Transforms": [
          {
            "PathRemovePrefix": "/order"
          }
        ]

      },

      "payment-swagger-route": {
        "ClusterId": "PaymentCluster",
        "Match": {
          "Path": "/payment/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/payment"
          }
        ]
      },

      "payment": {

        "ClusterId": "PaymentCluster",

        "Match": {

          "Path": "/payment/{**catch-all}"

        },
        "Transforms": [
          {
            "PathRemovePrefix": "/payment"
          }
        ]

      }

    },

    "Clusters": {



      "CustomerCluster": {

        "Destinations": {

          "destination1": {

            //"Address": "https://localhost:5001/"
            "Address": "http://customerauthservice:8080/"

          }

        }

      },

      "ProductCluster": {

        "Destinations": {

          "destination1": {

            //"Address": "https://localhost:5002/"
            "Address": "http://productservice:8080/"

          }

        }

      },

      "OrderCluster": {

        "Destinations": {

          "destination1": {

            //"Address": "https://localhost:5003/"
            "Address": "http://orderservice:8080"

          }

        }

      },



      "PaymentCluster": {

        "Destinations": {

          "destination1": {

            //"Address": "https://localhost:5004/"
            "Address": "http://paymentservice:8080/"

          }

        }

      },

      "NotificationCluster": {

        "Destinations": {

          "destination1": {

            //"Address": "https://localhost:5005/"
            "Address": "http://notificationservice:8080/"

          }

        }

      }

    }

  }


}










 
